# VidSnap backend environment template
# Copy to backend/.env for local development.
# Do not put real secrets in Git.

# ---------------------------------------------------------------------------
# Local database
# ---------------------------------------------------------------------------
# docker-compose default. Override in production.
DATABASE_URL=postgresql+asyncpg://vidsnap:vidsnap_secret_2024@localhost:5432/vidsnap

# If POSTGRES_PASSWORD is needed by docker-compose, set it in the project root
# .env or shell environment because docker-compose is launched from repo root.
# POSTGRES_PASSWORD=vidsnap_secret_2024

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Replace in production with a strong random value.
JWT_SECRET=change-me-in-production
JWT_LIFETIME_SECONDS=604800

# Optional Google OAuth.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Aliyun DashScope / Qwen / Paraformer
# ---------------------------------------------------------------------------
QWEN_API_KEY=your_qwen_api_key_here
TRANSCRIPT_SERVICE_API_KEY=your_transcript_service_api_key_here

# Optional: set when the default DashScope endpoint is not reachable from the
# current network or region.
# DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1

PARAFORMER_TRANSCRIPTION_SUBMIT_RETRIES=3
PARAFORMER_TRANSCRIPTION_FETCH_RETRIES=5
PARAFORMER_TRANSCRIPTION_RETRY_BASE_SECONDS=2
PARAFORMER_MAX_WAIT_SECONDS=1800
PARAFORMER_POLL_INTERVAL_SECONDS=5
PARAFORMER_AUDIO_FORMAT=flac
PARAFORMER_CHUNK_SECONDS=1800
PARAFORMER_MAX_PARALLEL_CHUNKS=2
LOCAL_ASR_ENABLED=false

# ---------------------------------------------------------------------------
# Aliyun OSS
# ---------------------------------------------------------------------------
# Local development can keep OSS disabled for planner/API work. Real Paraformer
# transcription needs a cloud-accessible audio URL, so enable OSS for full runs.
ENABLE_OSS_UPLOADS=false
OSS_USE_SIGNED_URLS=true
OSS_SIGNED_URL_EXPIRES_SECONDS=86400
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_BUCKET=your_bucket_name

# ---------------------------------------------------------------------------
# Runtime paths
# ---------------------------------------------------------------------------
TEMP_DIR=/tmp/video_analysis

# ---------------------------------------------------------------------------
# Email notifications
# ---------------------------------------------------------------------------
GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_FROM=
APP_URL=https://vidsnap.pccoding666.com

# ---------------------------------------------------------------------------
# Optional local proxy for start_local.sh
# ---------------------------------------------------------------------------
# VIDSNAP_HTTP_PROXY=http://127.0.0.1:7890
# VIDSNAP_HTTPS_PROXY=http://127.0.0.1:7890
# VIDSNAP_ALL_PROXY=socks5://127.0.0.1:7891
