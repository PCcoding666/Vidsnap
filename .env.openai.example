# 阿里云视频分析平台环境变量配置
# 复制此文件为 .env 并填入你的实际配置
# 更新版本：使用OpenAI Whisper替代阿里云语音服务

# =============================================================================
# 阿里云基础配置
# =============================================================================
# 阿里云访问密钥（在阿里云控制台获取）
ALIYUN_ACCESS_KEY_ID=your_access_key_id_here
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret_here

# =============================================================================
# 阿里云OSS对象存储配置
# =============================================================================
# OSS Endpoint（选择最近的区域）
# 华东1（杭州）: https://oss-cn-hangzhou.aliyuncs.com
# 华东2（上海）: https://oss-cn-shanghai.aliyuncs.com
# 华北1（青岛）: https://oss-cn-qingdao.aliyuncs.com
# 华北2（北京）: https://oss-cn-beijing.aliyuncs.com
# 华南1（深圳）: https://oss-cn-shenzhen.aliyuncs.com
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# OSS存储桶名称（需要预先创建）
ALIYUN_OSS_BUCKET=your_video_analysis_bucket

# =============================================================================
# OpenAI语音识别服务配置
# =============================================================================
# OpenAI API密钥（替代阿里云语音服务）
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# 可选配置
# =============================================================================
# 应用运行端口
APP_PORT=7860

# 调试模式
DEBUG_MODE=False

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 临时文件存储目录
TEMP_DIR=/tmp/aliyun_video_analysis

# =============================================================================
# 服务配置说明
# =============================================================================
# 
# 1. 阿里云访问密钥配置：
#    - 登录阿里云控制台 > 访问控制 > 用户管理
#    - 创建或使用现有RAM用户
#    - 为用户分配 OSS 权限（不再需要语音服务权限）
#    - 创建AccessKey并复制到上面
#
# 2. OSS存储桶配置：
#    - 登录阿里云控制台 > 对象存储OSS
#    - 创建新的存储桶（建议选择与应用部署相同的地域）
#    - 设置适当的读写权限
#    - 将存储桶名称填入 ALIYUN_OSS_BUCKET
#
# 3. OpenAI API配置：
#    - 访问 https://platform.openai.com/api-keys
#    - 创建新的API密钥
#    - 将密钥填入 OPENAI_API_KEY
#    - 确保账户有足够的余额用于Whisper API调用
#
# 4. 权限配置建议：
#    RAM用户只需要OSS权限：
#    - AliyunOSSFullAccess （OSS完整权限）
#
# 5. 成本说明：
#    - OSS存储费用：按存储量和流量计费
#    - OpenAI Whisper费用：$0.006/分钟音频
#    - 相比阿里云语音服务更简单且通常更便宜
#
# =============================================================================