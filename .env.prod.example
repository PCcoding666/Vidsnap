# ===== VidSnap 生产环境变量 =====
# 复制为 .env 后填写：cp .env.prod.example .env
# .env 含密钥，切勿提交到 Git（已在 .gitignore 忽略）。

# --- 对外 HTTP 端口（前端 nginx 入口）---
HTTP_PORT=8080

# --- 数据库（容器内 Postgres，密码务必改成强随机值）---
POSTGRES_PASSWORD=CHANGE_ME_强随机密码

# --- DashScope / Qwen（必填，转录 + LLM）---
# 用阿里云百炼/DashScope 新建的、未泄露的 key
QWEN_API_KEY=
TRANSCRIPT_SERVICE_API_KEY=
# 如需自定义 endpoint 再填，否则留空
QWEN_API_BASE=

# --- 阿里云 OSS（真实 Paraformer 转录必需）---
ENABLE_OSS_UPLOADS=true
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com

# --- 安全 ---
SECRET_KEY=CHANGE_ME_强随机值

# --- 日志 ---
LOG_LEVEL=INFO

# 说明：
# - DATABASE_URL / REDIS_URL / TEMP_DIR / STORAGE_DIR 由 docker-compose.prod.yml 注入，无需在此设置。
# - slim 版使用本地 PostgreSQL，无需第三方数据库配置。
