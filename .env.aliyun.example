# 阿里云视频分析平台环境变量配置
# 复制此文件为 .env 并填入你的实际配置

# =============================================================================
# 阿里云基础配置
# =============================================================================
# 阿里云访问密钥（在阿里云控制台获取）
ALIYUN_ACCESS_KEY_ID=your_access_key_id_here
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret_here

# =============================================================================
# 阿里云OSS对象存储配置
# =============================================================================
# OSS Endpoint（选择最近的区域）
# 华东1（杭州）: https://oss-cn-hangzhou.aliyuncs.com
# 华东2（上海）: https://oss-cn-shanghai.aliyuncs.com
# 华北1（青岛）: https://oss-cn-qingdao.aliyuncs.com
# 华北2（北京）: https://oss-cn-beijing.aliyuncs.com
# 华南1（深圳）: https://oss-cn-shenzhen.aliyuncs.com
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# OSS存储桶名称（需要预先创建）
ALIYUN_OSS_BUCKET=yt-summerizer

# =============================================================================
# 阿里云智能语音服务配置
# =============================================================================
# 智能语音服务 AppKey（在语音服务控制台获取）
ALIYUN_SPEECH_APP_KEY=your_speech_app_key_here

# =============================================================================
# 可选配置
# =============================================================================
# 应用运行端口
APP_PORT=7860

# 调试模式
DEBUG_MODE=False

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 临时文件存储目录
TEMP_DIR=/tmp/aliyun_video_analysis


OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# 服务配置说明
# =============================================================================
# 
# 1. 阿里云访问密钥配置：
#    - 登录阿里云控制台 > 访问控制 > 用户管理
#    - 创建或使用现有RAM用户
#    - 为用户分配 OSS 和智能语音服务的权限
#    - 创建AccessKey并复制到上面
#
# 2. OSS存储桶配置：
#    - 登录阿里云控制台 > 对象存储OSS
#    - 创建新的存储桶（建议选择与应用部署相同的地域）
#    - 设置适当的读写权限
#    - 将存储桶名称填入 ALIYUN_OSS_BUCKET
#
# 3. 智能语音服务配置：
#    - 登录阿里云控制台 > 智能语音交互
#    - 开通录音文件识别服务
#    - 创建项目并获取 AppKey
#    - 将 AppKey 填入 ALIYUN_SPEECH_APP_KEY
#
# 4. 权限配置建议：
#    RAM用户需要以下权限：
#    - AliyunOSSFullAccess （OSS完整权限）
#    - AliyunNLSFullAccess （智能语音完整权限）
#    或者配置更细粒度的权限策略
#
# =============================================================================