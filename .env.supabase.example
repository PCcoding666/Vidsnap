# ==============================================================================
# Supabase 配置示例
# ==============================================================================
# 请复制此文件为 .env 并填入您的实际配置
# 命令: cp .env.supabase.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase 配置
# ------------------------------------------------------------------------------
# 获取方式: https://app.supabase.com/project/YOUR_PROJECT/settings/api
#
# 1. 登录 Supabase Dashboard
# 2. 选择您的项目
# 3. 点击左侧菜单 Settings > API
# 4. 在 "Project URL" 和 "API Keys" 部分找到以下信息

# Supabase 项目 URL (格式: https://xxx.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 匿名密钥 (Anon/Public Key) - 可以公开,用于客户端
# 注意: 这个密钥受 RLS (Row Level Security) 保护
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1pZCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNjg5MDAwMDAwLCJleHAiOjIwMDQ1NzYwMDB9.your-anon-key-here

# ⚠️ Supabase 服务角色密钥 (Service Role Key) - 严格保密!
# 警告: 此密钥拥有绕过 RLS 的完全数据库访问权限
# - 仅在后端服务器环境使用
# - 严禁暴露给前端或客户端
# - 严禁提交到 Git 仓库
# - 应通过环境变量注入,禁止硬编码
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1pZCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE2ODkwMDAwMDAsImV4cCI6MjAwNDU3NjAwMH0.your-service-role-key-here

# ------------------------------------------------------------------------------
# 阿里云服务配置 (保持现有配置)
# ------------------------------------------------------------------------------

# 阿里云访问密钥
ALIYUN_ACCESS_KEY_ID=your_access_key_id_here
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret_here

# 阿里云 OSS 配置
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=your-bucket-name-here

# 阿里云 DashScope API Key (用于 Qwen AI 服务)
QWEN_API_KEY=sk-your-qwen-api-key-here

# 音频转录服务 API Key (如果使用专用密钥)
TRANSCRIPT_SERVICE_API_KEY=

# ------------------------------------------------------------------------------
# 应用配置
# ------------------------------------------------------------------------------

# 临时文件目录
TEMP_DIR=/tmp/video_analysis

# 服务端口
PORT=8000

# ------------------------------------------------------------------------------
# 代理配置 (如果需要)
# ------------------------------------------------------------------------------

# HTTP 代理
# https_proxy=http://127.0.0.1:33210
# http_proxy=http://127.0.0.1:33210
# all_proxy=socks5://127.0.0.1:33211

# ==============================================================================
# 配置说明
# ==============================================================================
#
# 【Supabase 密钥获取步骤】
#
# 1. 创建 Supabase 项目
#    - 访问: https://app.supabase.com/
#    - 点击 "New Project"
#    - 填写项目名称、数据库密码、地区
#    - 等待项目创建完成(约 1-2 分钟)
#
# 2. 获取 API 密钥
#    - 进入项目 Dashboard
#    - 点击左侧菜单 "Settings" > "API"
#    - 找到以下信息:
#      * Project URL: 复制到 SUPABASE_URL
#      * anon public: 复制到 SUPABASE_ANON_KEY
#      * service_role: 复制到 SUPABASE_SERVICE_KEY
#
# 3. 初始化数据库
#    - 点击左侧菜单 "SQL Editor"
#    - 点击 "New query"
#    - 复制 backend/sql/schema_v1.sql 的内容
#    - 粘贴并点击 "Run" 执行
#    - 等待执行完成,检查是否有错误
#
# 4. 验证配置
#    - 点击左侧菜单 "Table Editor"
#    - 应该看到 7 个新创建的表:
#      * profiles
#      * user_quotas
#      * videos
#      * keyframes
#      * transcripts
#      * transcript_segments
#      * video_summaries
#
# 【安全提示】
#
# - 将此文件添加到 .gitignore
# - 定期轮换 API 密钥
# - 生产环境使用密钥管理服务
# - 启用 Supabase 项目的 IP 白名单
#
# 【测试配置】
#
# 运行以下命令验证配置是否正确:
#
#   python -c "from app.services.supabase_service import supabase_service; print('✅ Supabase 可用' if supabase_service.is_available() else '❌ Supabase 不可用')"
#
# ==============================================================================
