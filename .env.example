# Simple YouTube Video Summarizer Environment Variables

# OpenAI API Configuration (for speech transcription and summarization)
OPENAI_API_KEY=your_openai_api_key_here

# Alternative: Qwen/DashScope API Configuration (for summarization)
QWEN_API_KEY=your_qwen_api_key_here
# or
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Application Configuration
PORT=7860

# Optional: Logging level
LOG_LEVEL=INFO